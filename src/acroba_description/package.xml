<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>acroba_description</name>
  <version>0.0.1</version>
  <description>
    The ACROBA demonstrator (BFH): a UR5e with a Robotiq 2F-85 on a table
    with a frame behind the arm. Composes the vanilla ur_description,
    cell_description's 2F-85 module and the cell's own rig (table and
    frame, one mesh); MoveIt launch for the cell's
    generated configuration (acroba_description/cells/acroba.yaml).
  </description>
  <maintainer email="norman.baier@bfh.ch">Norman Urs Baier</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>cell_description</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
