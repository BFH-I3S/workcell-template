<?xml version="1.0"?>
<!--
  acroba.urdf.xacro

  The ACROBA demonstrator (BFH), composed as every cell here is
  (acroba_description/cells/acroba.yaml)

    world        the robot base at the origin, on its base plate
    ur5e         the vanilla ur_description, unprefixed (base_link, tool0)
    2F-85        cell_description's robotiq_2f_85_module on tool0, with the
                 TCP gripper_tcp
    workcell     on world, identity
    the camera   cell_description's depth_camera_module on world, the type
                 from cells/acroba.yaml, the pose from its calibration file
    the rig      what no vendor package has, acroba_rig.urdf.xacro, the
                 table with the robot's base plate and the frame behind it,
                 and the cable cover on tool0

  Not upstream's description, which has its own TCP (virtual_tcp_link, 174 mm
  from tool0) and its own coupling and gripper links. The skills and the
  composition expect an unprefixed arm, a gripper module and gripper_tcp.

  The arm's kinematics default to the real UR5e's calibration
  (config/ur5e_calibration.yaml, from acroba_demonstrator_control), so plans
  match the arm the driver runs.

  With sim_gazebo (acroba_sim) the description also carries what Gazebo
  needs, the arm's from cell_description's ur_gazebo macro and the gripper's
  from its module, as in every cell (the reasoning is in those files)
    the arm's ros2_control block on GazeboSimSystem, with the wrist force
    torque sensor on wrist_3_joint, starting in acroba_home
    the gz_ros2_control plugin, with the cell's generated controller file
    (simulation_controllers)
    the 2F-85 module's Gazebo ros2_control block, fingertip pads, wrist
    spring, compliant rubber pads and raised finger velocity limits, as on
    the gantry, for dartsim
    one DetachableJoint per graspable part, the grasp_models of acroba_sim's
    sim_gripper_driver.yaml (none yet)

  Keep comments here free of colons (launch_ros reads robot_description as
  YAML first).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="acroba">
  <!-- The arm, from ur_description's macro, as on the gantry; the same
       arguments and defaults as ur_description's own ur.urdf.xacro, except
       name and the calibrated kinematics. Mesh paths absolute in Gazebo only,
       which resolves them without GZ_SIM_RESOURCE_PATH; RViz and MoveIt keep
       package URIs. -->
  <xacro:arg name="name" default="acroba"/>
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find acroba_description)/config/ur5e_calibration.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="sim_gazebo" default="false"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <!-- The 2F-85's simulation-only fingertip pads, as on the gantry (see
       cell_description). On with sim_gazebo for Gazebo; MoveIt's copy of the
       simulated description keeps them as the fingertips' collision geometry
       and turns contact_compliance off. -->
  <xacro:arg name="contact_pads" default="$(arg sim_gazebo)"/>
  <!-- Simulation-only spring between flange and gripper and the pads' rubber
       springs, for force control and grasping against dartsim's rigid
       contacts (see cell_description). It follows contact_pads. -->
  <xacro:arg name="contact_compliance" default="$(arg contact_pads)"/>
  <!-- The camera, by default the type the composition names, so that nothing
       but cells/acroba.yaml says which one the cell has and every user of this
       description follows it. check_composition.py sets it to try the others. -->
  <xacro:arg name="camera_type" default=""/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find cell_description)/urdf/ur_gazebo.urdf.xacro"/>
  <xacro:include filename="$(find cell_description)/urdf/robotiq_2f_85_module.urdf.xacro"/>
  <xacro:include filename="$(find cell_description)/urdf/workcell_frame.urdf.xacro"/>
  <xacro:include filename="$(find cell_description)/urdf/border.urdf.xacro"/>
  <xacro:include filename="$(find cell_description)/urdf/depth_camera_module.urdf.xacro"/>
  <xacro:include filename="$(find acroba_description)/urdf/acroba_rig.urdf.xacro"/>

  <link name="world"/>
  <!-- The arm's input border (border.urdf.xacro), where base_link hangs. -->
  <xacro:module_border type="ur" instance="arm" role="mount" parent="world"/>
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="arm_mount"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    force_abs_paths="$(arg sim_gazebo)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>


  <!-- As the gantry mounts it. raise_finger_velocity_limits follows
       sim_gazebo, dartsim has no mimic constraints. -->
  <xacro:robotiq_2f_85_module parent="tool0" name="RobotiqGripperSim"
                              sim_gazebo="$(arg sim_gazebo)" include_ros2_control="$(arg sim_gazebo)"
                              contact_pads="$(arg contact_pads)"
                              contact_compliance="$(arg contact_compliance)"
                              pad_compliance="$(arg contact_compliance)"
                              raise_finger_velocity_limits="$(arg sim_gazebo)"/>

  <xacro:workcell_frame parent="world"/>

  <xacro:property name="composition_file" value="$(find acroba_description)/cells/acroba.yaml"/>
  <xacro:property name="camera_spec" value="${xacro.load_yaml(composition_file)['modules']['camera']}"/>
  <xacro:property name="camera_type" value="${xacro.arg('camera_type') or camera_spec['type']}"/>
  <xacro:property name="calibration_dir" value="$(find acroba_description)/config"/>
  <xacro:depth_camera_module type="${camera_type}" parent="${camera_spec['parent']}"
                             calibration_file="${calibration_dir + '/' + camera_type + '_calibration.yaml'}"
                             sim_gazebo="$(arg sim_gazebo)"/>

  <!-- The rig, the hardware in no vendor package. -->
  <xacro:acroba_rig parent="world" flange="tool0"/>

  <xacro:if value="$(arg sim_gazebo)">
    <!-- Gazebo never sees the cell. acroba_cell_link has no inertial, so
         sdformat drops it with its visuals and collisions when it converts
         the description. acroba_sim's world has the cell as a model of its
         own, which the arm collides with (Gazebo does not collide a model
         with itself). -->

    <!-- The arm's Gazebo parts, see cell_description's ur_gazebo.urdf.xacro.
         It starts in acroba_home (cells/acroba.yaml), the gripper pointing
         down over the table, elbow up. With the wrist spring held parts hang on its gripper side. -->
    <xacro:property name="grasp_parent" value="wrist_3_link"/>
    <xacro:if value="$(arg contact_compliance)">
      <xacro:property name="grasp_parent" value="robotiq_compliance_link"/>
    </xacro:if>
    <xacro:ur_gazebo
        name="acroba_arm" tf_prefix="$(arg tf_prefix)"
        initial_positions="${dict(shoulder_pan_joint=1.57, shoulder_lift_joint=-1.57, elbow_joint=1.57,
                                  wrist_1_joint=-1.57, wrist_2_joint=-1.57, wrist_3_joint=0.0)}"
        simulation_controllers="$(arg simulation_controllers)"
        grasp_models_file="$(find acroba_sim)/config/sim_gripper_driver.yaml"
        grasp_parent="${grasp_parent}"/>
  </xacro:if>

  <!-- The real robot, ur_robot_driver's ros2_control block (cell_description's
       ur_driver.urdf.xacro, how to start the driver with this description is
       there); its mock hardware starts in acroba_home. -->
  <xacro:unless value="$(arg sim_gazebo)">
    <xacro:include filename="$(find cell_description)/urdf/ur_driver.urdf.xacro"/>
    <xacro:ur_driver
        name="$(arg name)" tf_prefix="$(arg tf_prefix)" ur_type="$(arg ur_type)"
        kinematics_params="$(arg kinematics_params)"
        initial_positions="${dict(shoulder_pan_joint=1.57, shoulder_lift_joint=-1.57, elbow_joint=1.57,
                                  wrist_1_joint=-1.57, wrist_2_joint=-1.57, wrist_3_joint=0.0)}"/>
  </xacro:unless>
</robot>
