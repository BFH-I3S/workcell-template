<?xml version="1.0"?>
<!--
  ur5e_2f85.urdf.xacro

  An example workcell. The structure is a table, the arm comes from ur_description
  and the gripper from Robotiq's package, both unmodified. Its modules are named in
  workcells/ur5e_2f85.yaml.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur5e_2f85"/>
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find workcell_template)/urdf/robotiq_2f_85_module.urdf.xacro"/>
  <xacro:include filename="$(find workcell_template)/urdf/workcell_frame.urdf.xacro"/>

  <!-- The structure: the root, the table and the workcell frame. -->
  <link name="world"/>
  <link name="table_link">
    <collision>
      <origin xyz="0 0 -0.0255" rpy="0 0 0"/>
      <geometry><box size="1.6 1.2 0.05"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 -0.0255" rpy="0 0 0"/>
      <geometry><box size="1.6 1.2 0.05"/></geometry>
    </visual>
  </link>
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table_link"/>
  </joint>
  <xacro:workcell_frame parent="world"/>

  <!-- The arm, on the structure. Its mount is its input border. -->
  <xacro:module_border type="ur" instance="arm" role="mount" parent="world"/>
  <xacro:ur_robot name="$(arg name)" tf_prefix="" parent="arm_mount"
                  joint_limits_parameters_file="$(arg joint_limit_params)"
                  kinematics_parameters_file="$(arg kinematics_params)"
                  physical_parameters_file="$(arg physical_params)"
                  visual_parameters_file="$(arg visual_params)"
                  safety_limits="true" safety_pos_margin="0.15" safety_k_position="20">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- The end effector, on the arm's output border. -->
  <xacro:robotiq_2f_85_module parent="tool0"/>
</robot>
