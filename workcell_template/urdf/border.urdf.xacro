<?xml version="1.0"?>
<!--
  border.urdf.xacro

  A border of the workcell template (CONVENTION.md). A workcell is a tree, with
  its own structure at the root and on it modules (carriers, arms, tool
  changers, end effectors, sensors); each module instance has one input border,
  instance_mount, and output borders other modules are mounted on (a carrier's
  instance_output, an arm's tool0, a changer's instance_coupling, an end
  effector's instance_tcp).
  Borders are frames without geometry, as REP 199's flange and tool0. The
  input border keeps the z axis of the output border it hangs on, and z
  points along the mounting direction, away from the parent;
  check_workcell.py checks both.

  module_border names the border as the module's descriptor does, by role, so
  that a module's names have one source (modules/type.yaml). A pass-through
  output a workcell adds, and the parent a mount hangs on, come from the workcell's file
  and are compared by check_workcell.py.

  Keep comments here free of colons (launch_ros reads robot_description as
  YAML first).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="border" params="name parent xyz:='0 0 0' rpy:='0 0 0'">
    <link name="${name}"/>
    <joint name="${parent}_to_${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:property name="border_modules_dir" value="$(find workcell_template)/modules"/>
  <xacro:macro name="module_border" params="type instance role parent xyz:='0 0 0' rpy:='0 0 0'">
    <xacro:property name="declared" value="${xacro.load_yaml(border_modules_dir + '/' + type + '.yaml')['frames'][role]}"/>
    <xacro:border name="${instance + declared if declared.startswith('_') else declared}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"/>
  </xacro:macro>
</robot>
